---
layout: default
---
<link rel="stylesheet" href="{{ '/assets/css/cv-custom.css' | relative_url | bust_file_cache }}">

{% if page.cv_format == 'rendercv' and site.data.cv.cv and site.plugins contains 'al_folio_cv' and site.al_folio.features.cv.enabled != false %}
  {% assign cv = site.data.cv.cv %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </header>

    <article class="site-cv">
      <section class="cv-section" aria-labelledby="cv-contact">
        <h2 id="cv-contact" class="cv-section-title">Contact Information</h2>
        <dl class="cv-contact">
          <dt>Name</dt>
          <dd>{{ cv.name | escape }}</dd>
          <dt>Professional Title</dt>
          <dd>{{ cv.label | escape }}</dd>
          <dt>Email</dt>
          <dd>{% al_email_protect_link cv.email %}</dd>
          {% for address in cv.addresses %}
            <dt>Address {{ forloop.index }}</dt>
            <dd>
              {{ address.institution | escape }}<br>
              {{ address.street | escape }}<br>
              {{ address.postalCode | escape }} {{ address.city | escape }}, {{ address.country | escape }}
            </dd>
          {% endfor %}
        </dl>
      </section>

      {% assign section_names = 'Experience,Education' | split: ',' %}
      {% for section_name in section_names %}
        {% assign entries = cv.sections[section_name] | al_cv_sort_by_date %}
        {% if entries.size > 0 %}
          <section class="cv-section" aria-labelledby="cv-{{ section_name | slugify }}">
            <h2 id="cv-{{ section_name | slugify }}" class="cv-section-title">{{ section_name }}</h2>
            <ul class="cv-entries">
              {% for entry in entries %}
                <li class="cv-entry">
                  <div class="cv-entry-date">
                    {% assign start_date = entry.start_date | append: '' | replace: '-', '.' %}
                    {% assign end_date = entry.end_date | append: '' | replace: '-', '.' %}
                    <span class="cv-date-badge">{{ start_date | escape }} &ndash; {{ end_date | escape }}</span>
                  </div>
                  <div class="cv-entry-content">
                    {% if section_name == 'Experience' %}
                      <h3 class="cv-entry-title">{{ entry.position | escape }}</h3>
                      <p class="cv-entry-institution">{{ entry.company | escape }}</p>
                    {% else %}
                      <h3 class="cv-entry-title">{{ entry.studyType | escape }}</h3>
                      <p class="cv-entry-institution">{{ entry.institution | escape }}, {{ entry.location | escape }}</p>
                    {% endif %}
                    {% if entry.summary or entry.highlights.size > 0 %}
                      <ul class="cv-entry-details">
                        {% if entry.summary %}
                          <li>{{ entry.summary | escape }}</li>
                        {% endif %}
                        {% for highlight in entry.highlights %}
                          <li>{{ highlight | markdownify | remove: '<p>' | remove: '</p>' }}</li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      {% endfor %}
    </article>
  </div>
{% else %}
  {% al_folio_cv_render %}
{% endif %}
